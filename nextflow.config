/*~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    xtelin Delly BND Nextflow Config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~*/

nextflow.enable.dsl = 2

manifest {
    name            = 'xtelin/delly-bnd'
    description     = 'Delly v1.7.2 cross-chr BND + GT detection'
    author          = 'xtelin'
    version         = '0.1.0'
    nextflowVersion = '>=23.10'
}

// Default resources
process {
    cpus   = 4
    memory = '8 GB'
    time   = '6h'
}

// Profiles
profiles {

    docker {
        docker.enabled          = true
        docker.userEmulation    = true
        docker.armEmulation     = false
        docker.platform         = 'linux/arm64'
        docker.runOptions       = '-u $(id -u):$(id -g)'
        process {
            container = 'xtelin/delly-bnd:v1.7.2'
        }
    }

    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        process {
            container = 'docker://xtelin/delly-bnd:v1.7.2'
        }
    }

    local {
        docker.enabled      = false
        singularity.enabled = false
    }
}

// Execution
workDir  = '/tmp/xtelin-nf/work'
cacheDir = '/tmp/xtelin-nf/cache'

// Reports (all JSON)
timeline { enabled = true; file = 'nf_reports/timeline.json' }
report   { enabled = true; file = 'nf_reports/report.json' }
trace    { enabled = true; file = 'nf_reports/trace.json' }
